# Email de contact affiché publiquement (footer, mailto).
CONTACT_EMAIL=pamahe@proton.me

# Destinataire des demandes (email Resend + repli journal).
DEVIS_RECIPIENT=pamahe@proton.me

# Resend (email) — prioritaire si la clé est présente. À mettre dans .env (jamais commité).
# Le `from` doit être un domaine vérifié chez Resend ; onboarding@resend.dev en test.
RESEND_API_KEY=
RESEND_FROM=CHOM <onboarding@resend.dev>

# Repli si pas de Resend : URL de webhook (Slack, Make/n8n, transfert email…).
DEVIS_WEBHOOK_URL=
