# Production — copier en `.env` sur la VM puis renseigner. NE PAS committer `.env`.
# Le TLS / l'entrée 80-443 sont gérés par le Traefik externe (LXC) — rien ici.

# --- Exposition LAN pour le Traefik externe ---
# Port publié sur la VM (Traefik proxifie vers http://<IP_VM>:<HOST_PORT>).
HOST_PORT=3000
# Restreindre à l'interface LAN que voit Traefik (recommandé). Vide/0.0.0.0 = toutes.
HTTP_BIND=0.0.0.0

# --- Contact & destinataire des demandes ---
CONTACT_EMAIL=pamahe@proton.me
DEVIS_RECIPIENT=pamahe@proton.me

# --- Envoi des formulaires par email (Resend) ---
# Clé API Resend (https://resend.com). Obligatoire pour l'envoi réel.
RESEND_API_KEY=
# Expéditeur : DOIT être un domaine vérifié chez Resend une fois en prod.
# Tant que chom.re n'est pas vérifié, onboarding@resend.dev fonctionne (test).
RESEND_FROM=CHOM <contact@chom.re>

# --- Optionnel : repli webhook si pas de Resend (Slack, Make, transfert email…) ---
DEVIS_WEBHOOK_URL=
